<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DosingApp.Views.RemotePage"
             Title="Обмен данными">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout 
                Margin="{StaticResource PageMargin}">
                <StackLayout>

                    <Label 
                        Text="Адрес"
                        TextColor="{StaticResource LabelEntryColor}"/>
                    <Entry 
                        x:Name="addressEntry"
                        Placeholder="Введите адрес для доступа" 
                        Text="{Binding BaseAddress}"
                        Keyboard="Chat"/>

                    <Label 
                        Text="Email планшета"
                        TextColor="{StaticResource LabelEntryColor}"/>
                    <Entry 
                        x:Name="emailEntry"
                        Placeholder="Введите email" 
                        Text="{Binding Email}"
                        Keyboard="Chat"/>

                    <Label 
                        Text="Пароль"
                        TextColor="{StaticResource LabelEntryColor}"/>
                    <Entry 
                        x:Name="passwordEntry"
                        Placeholder="Введите пароль"
                        Text="{Binding Password}"
                        Keyboard="Chat"/>
                    
                </StackLayout>
                <StackLayout>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button 
                            Text="Загрузить"
                            Command="{Binding DownloadCommand}" 
                            CommandParameter="{Binding}" />
                        <Button 
                            Grid.Column="1" 
                            Text="Выгрузить"
                            Command="{Binding UploadCommand}" 
                            CommandParameter="{Binding}" />
                    </Grid>
                </StackLayout>

            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>